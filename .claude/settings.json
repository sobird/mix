{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "bun -e 'const f=(JSON.parse(await Bun.stdin.text()).tool_input||{}).file_path; if(f && /\\.(js|jsx|ts|tsx|mjs|cjs|json|jsonc|css|scss|less|md|yml|yaml)$/.test(f)) Bun.spawnSync([\"bunx\",\"oxfmt\",f],{stdout:\"ignore\",stderr:\"inherit\"})' 2>/dev/null || true",
            "timeout": 30
          }
        ]
      }
    ]
  },
  "enabledPlugins": {
    "superpowers@claude-plugins-official": true,
    "code-review@claude-plugins-official": true,
    "skill-creator@claude-plugins-official": true,
    "playwright@claude-plugins-official": true,
    "github@claude-plugins-official": true,
    "commit-commands@claude-plugins-official": true
  }
}
